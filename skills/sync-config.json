{
    "description": "Mapeamento de repos para grupos de skills. Cada repo recebe as skills das pastas listadas em 'folders', sincronizadas para .claude/skills/<nome>/SKILL.md. Os repos de frontend ficam separados por stack: 'frontend-angular' recebe a pasta angular e 'frontend-react' recebe a pasta react. 'exclusiveFolders' lista pastas que nunca chegam juntas ao mesmo repo; o sync falha antes de copiar se algum repo receberia mais de uma pasta do mesmo conjunto.",
    "groups": {
        "backend": {
            "folders": ["shared", "backend"],
            "repos": ["zoppy-api", "zoppy-workflow", "zoppy-pixel-lambda", "zoppy-event-bridge"]
        },
        "wpp-commerce": {
            "folders": ["shared", "wpp-commerce"],
            "repos": ["zoppy-whatsapp-commerce"]
        },
        "wpp-commerce-fe": {
            "folders": ["shared"],
            "repos": ["zoppy-whatsapp-commerce-FE"]
        },
        "frontend-angular": {
            "folders": ["shared", "angular"],
            "repos": ["zoppy-FE", "ui-components", "zoppy-partners-fe", "zoppy-admin-fe"]
        },
        "frontend-react": {
            "folders": ["shared", "react"],
            "repos": ["zoppy-ai-agent-fe"]
        },
        "e2e": {
            "folders": ["shared", "e2e"],
            "repos": ["zoppy-e2e-api"]
        },
        "e2e-jornadas": {
            "folders": ["e2e-jornadas"],
            "repos": ["zoppy-FE", "zoppy-e2e-api"]
        },
        "observability": {
            "folders": ["shared", "observability"],
            "repos": ["zoppy-eng-metrics"]
        }
    },
    "exclusiveFolders": [["angular", "react"]]
}
