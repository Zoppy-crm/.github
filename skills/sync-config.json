{
    "description": "Mapeamento de repos para grupos de skills. Cada repo recebe as skills das pastas listadas em 'folders', sincronizadas para .claude/skills/<nome>/SKILL.md",
    "groups": {
        "backend": {
            "folders": ["shared", "backend"],
            "repos": ["zoppy-api", "zoppy-workflow", "zoppy-pixel-lambda", "zoppy-event-bridge"]
        },
        "wpp-commerce": {
            "folders": ["shared", "wpp-commerce"],
            "repos": ["zoppy-whatsapp-commerce"]
        },
        "wpp-commerce-fe": {
            "folders": ["shared"],
            "repos": ["zoppy-whatsapp-commerce-FE"]
        },
        "frontend": {
            "folders": ["shared", "frontend"],
            "repos": ["zoppy-FE", "ui-components", "zoppy-partners-fe", "zoppy-admin-fe"]
        },
        "e2e": {
            "folders": ["shared", "e2e"],
            "repos": ["zoppy-e2e-api"]
        },
        "observability": {
            "folders": ["shared"],
            "repos": ["zoppy-eng-metrics"]
        }
    }
}
